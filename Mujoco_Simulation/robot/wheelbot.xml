<mujoco model="two_wheeled_robot">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  
  <option timestep="0.0001" integrator="RK4" gravity="0 0 -9.81"/>
  

  <asset>
    <!-- Textures and materials for better visualization -->
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300" mark="edge" markrgb=".2 .3 .4"/>
    <material name="grid_mat" texture="grid" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
  <light pos="2 2 0.5" cutoff="100"  dir="0 0 -1" diffuse="1 1 1" specular=".2 .2 .2" directional="false"  castshadow="true"/>
 
    <!-- Ground Plane -->
    <geom name="floor" pos="0 0 0" size="0 0 .25" type="plane" material="grid_mat" condim="3"/>

    <!-- Robot Body -->
    <body name="chassis" pos="0 0 0.1">
      <freejoint name="root"/>
      
      <!-- Main body: flat cylinder -->
      <geom name="chassis_geom" type="cylinder" size="0.2 0.05" rgba="0.2 0.5 0.8 1"/>
      <body name="sensor_array" pos="0.18 0 0.055"> <!-- On top, near the front edge -->
  
        <!-- Visual markers for the sensors -->
        <geom name="left_eye" pos="0 0.05 0" type="cylinder" size="0.01 0.005" rgba="1 1 0 1"/>
        <geom name="right_eye" pos="0 -0.05 0" type="cylinder" size="0.01 0.005" rgba="1 1 0 1"/>

        <!-- Sites: These are the actual 'mounting points' for sensors -->
        <site name="light_sensor_left" pos="0 0.05 0" size="0.01" quat="0 0 1 0"/>
<site name="light_sensor_right" pos="0 -0.05 0" size="0.01" quat="0 0 1 0"/>
      </body>
      <!-- Left Wheel -->
      <body name="left_wheel" pos="0 0.22 0" quat="1 1 0 0">
        <joint name="left_wheel_joint" type="hinge" axis="0 0 1"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.1 0.02" rgba="0.1 0.1 0.1 1" friction="1 0.005 0.0001"/>
      </body>

      <!-- Right Wheel -->
      <body name="right_wheel" pos="0 -0.22 0" quat="1 1 0 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 0 1"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.1 0.02" rgba="0.1 0.1 0.1 1" friction="1 0.005 0.0001"/>
      </body>

      <!-- Ball Caster (Balance) -->
      <!-- Low friction allows it to slide easily while providing support -->
      <body name="caster" pos="0.15 0 -0.05">
        <geom name="caster_geom" type="sphere" size="0.05" rgba="0.8 0.8 0.8 1" friction="0.01 0.005 0.0001"/>
      </body>
    </body>
  </worldbody>

  <!-- Actuators for the two motors -->
  <actuator>
    <velocity name="left_motor" joint="left_wheel_joint" kv="10"/>
    <velocity name="right_motor" joint="right_wheel_joint" kv="10"/>
  </actuator>
  <sensor>
  <!-- Rangefinders can simulate a simple IR/light ground sensor -->
  <rangefinder name="left_ir" site="light_sensor_left"/>
  <rangefinder name="right_ir" site="light_sensor_right"/>
</sensor>
</mujoco>
